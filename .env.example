PORT=3000

# MongoDB — riwayat posisi (lokal atau Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/belajar-ais

# PostgreSQL — data statis kapal & pelabuhan
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ais_monitor

# Opsional: retensi riwayat posisi dalam hari (0 = simpan selamanya)
POSITION_TTL_DAYS=30

# Opsional: pakai DNS public (8.8.8.8/1.1.1.1) bila SRV MongoDB Atlas
# gagal resolve di jaringanmu. Default false karena mengubah DNS seluruh proses.
USE_PUBLIC_DNS=false